# font settings
font-family = D2CodingLigature Nerd Font
font-size = 16
font-feature = -calt

# themes
# The active theme is machine-local: scripts/toggle-theme writes theme.local
# (git-ignored) from the dotfiles root's theme.conf. Run `toggle-theme --apply`
# once on a fresh checkout to generate it.
config-file = ?theme.local

# machine-local overrides
# local.conf (git-ignored, hand-written, optional) is read last, so anything in
# it wins over the settings above -- a different font-size on one machine, say.
# Do not put those in theme.local: toggle-theme rewrites that file on every run.
config-file = ?local.conf

# macos settings
macos-titlebar-style = tabs
macos-option-as-alt = true

# cursor settings
cursor-color = cell-foreground
cursor-text = cell-background
cursor-style-blink = false

# basic settings
shell-integration = none
adjust-cell-height = 25%
window-padding-color = extend-always
copy-on-select = true
clipboard-read = allow
clipboard-write = allow

# nvim maps Ctrl-/ as <C-_>; send the matching control byte outside tmux too.
keybind = ctrl+slash=text:\x1f

# real color
term = xterm-256color

# scroll setup
mouse-scroll-multiplier = 0.5
