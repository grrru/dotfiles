#!/bin/bash
#
# Switch light/dark mode across Ghostty, tmux and Neovim.
#
#   toggle-theme            flip the current mode
#   toggle-theme light      force light mode
#   toggle-theme dark       force dark mode
#   toggle-theme --apply    re-apply the current mode without flipping it
#
# Which themes each mode uses is machine-local. Copy theme.conf.example to
# theme.conf in the dotfiles root (git-ignored) and edit it there.

STATE_FILE="$HOME/.theme_mode"
# Resolve the dotfiles root from this script's location (scripts/ -> repo root),
# falling back to ~/dotfiles when invoked through a copied path.
DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)"
[ -d "$DOTFILES/ghostty" ] || DOTFILES="$HOME/dotfiles"

# === Defaults (overridable from theme.conf) ===
GHOSTTY_LIGHT_THEME="Catppuccin Latte"
GHOSTTY_DARK_THEME="Catppuccin Frappe"
LIGHT_FONT_THICKEN_STRENGTH=70
DARK_FONT_THICKEN_STRENGTH=0

TMUX_LIGHT_STATUS_FG="#282C33"
TMUX_LIGHT_STATUS_BG="#d5d6db"
TMUX_LIGHT_PANE_BORDER_FG="#d5d6db"
TMUX_LIGHT_PANE_ACTIVE_BORDER_FG="#1D66F5"

TMUX_DARK_STATUS_FG="#d5d6db"
TMUX_DARK_STATUS_BG="#282C33"
TMUX_DARK_PANE_BORDER_FG="#3D4350"
TMUX_DARK_PANE_ACTIVE_BORDER_FG="#89b4fa"

# Theme names accepted by Claude Code's `theme` setting: light, dark,
# light-daltonized, dark-daltonized, light-ansi, dark-ansi. Empty disables the
# Claude Code integration.
CLAUDE_LIGHT_THEME="light"
CLAUDE_DARK_THEME="dark"

# First existing file wins. Keep this list in sync with the candidates in
# gruvim/lua/config/theme.lua.
for THEME_CONF in \
  ${DOTFILES_THEME_CONF:+"$DOTFILES_THEME_CONF"} \
  "$DOTFILES/theme.conf" \
  "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/theme.conf"; do
  if [ -f "$THEME_CONF" ]; then
    # shellcheck source=/dev/null
    . "$THEME_CONF"
    break
  fi
done

read_mode() {
  if [ -f "$STATE_FILE" ] && [ "$(cat "$STATE_FILE")" = "light" ]; then
    echo "light"
  else
    echo "dark"
  fi
}

# === Determine the target mode ===
case "${1-}" in
"")
  if [ "$(read_mode)" = "dark" ]; then NEW_MODE="light"; else NEW_MODE="dark"; fi
  ;;
light | dark) NEW_MODE="$1" ;;
--apply) NEW_MODE="$(read_mode)" ;;
-h | --help)
  sed -n '3,11p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  exit 0
  ;;
*)
  echo "toggle-theme: unknown argument '$1' (expected light, dark, --apply)" >&2
  exit 1
  ;;
esac

if [ "$NEW_MODE" = "light" ]; then
  GHOSTTY_THEME="$GHOSTTY_LIGHT_THEME"
  FONT_THICKEN_STRENGTH="$LIGHT_FONT_THICKEN_STRENGTH"
  TMUX_STATUS_FG="$TMUX_LIGHT_STATUS_FG"
  TMUX_STATUS_BG="$TMUX_LIGHT_STATUS_BG"
  TMUX_PANE_BORDER_FG="$TMUX_LIGHT_PANE_BORDER_FG"
  TMUX_PANE_ACTIVE_BORDER_FG="$TMUX_LIGHT_PANE_ACTIVE_BORDER_FG"
  CLAUDE_THEME="$CLAUDE_LIGHT_THEME"
else
  GHOSTTY_THEME="$GHOSTTY_DARK_THEME"
  FONT_THICKEN_STRENGTH="$DARK_FONT_THICKEN_STRENGTH"
  TMUX_STATUS_FG="$TMUX_DARK_STATUS_FG"
  TMUX_STATUS_BG="$TMUX_DARK_STATUS_BG"
  TMUX_PANE_BORDER_FG="$TMUX_DARK_PANE_BORDER_FG"
  TMUX_PANE_ACTIVE_BORDER_FG="$TMUX_DARK_PANE_ACTIVE_BORDER_FG"
  CLAUDE_THEME="$CLAUDE_DARK_THEME"
fi

# Neovim watches this file and picks its own colorscheme from theme.conf.
echo "$NEW_MODE" >"$STATE_FILE"

# === Ghostty ===
GHOSTTY_CONFIG="$DOTFILES/ghostty/config"
GHOSTTY_LOCAL_CONFIG="$DOTFILES/ghostty/theme.local"
if [ -d "$(dirname "$GHOSTTY_LOCAL_CONFIG")" ]; then
  {
    printf 'theme = %s\n' "$GHOSTTY_THEME"
    if [ "${FONT_THICKEN_STRENGTH:-0}" -gt 0 ] 2>/dev/null; then
      printf 'font-thicken = true\n'
      printf 'font-thicken-strength = %s\n' "$FONT_THICKEN_STRENGTH"
    else
      printf 'font-thicken = false\n'
    fi
  } >"$GHOSTTY_LOCAL_CONFIG"
  # Ghostty reloads when the main config file's mtime changes.
  touch "$GHOSTTY_CONFIG"
fi

# === Claude Code ===
# Claude Code keeps its theme in settings.json and reads it at startup only,
# so this rewrite covers new sessions. Already-running ones have to be driven
# through their own `/theme` picker, which CLAUDE_LIVE_THEME=1 turns on: this
# script types into the tmux panes running claude, and Neovim does the same
# through the job channel for the ones in its terminal buffers.
CLAUDE_SETTINGS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
if [ -n "$CLAUDE_THEME" ] && [ -f "$CLAUDE_SETTINGS" ] && command -v jq >/dev/null 2>&1; then
  CLAUDE_TMP="$(mktemp "${TMPDIR:-/tmp}/toggle-theme.XXXXXX")"
  if jq --arg theme "$CLAUDE_THEME" '.theme = $theme' "$CLAUDE_SETTINGS" >"$CLAUDE_TMP"; then
    # Write through the existing file rather than renaming over it: keeping the
    # inode keeps any watcher Claude Code has on the path attached.
    cat "$CLAUDE_TMP" >"$CLAUDE_SETTINGS"
  fi
  rm -f "$CLAUDE_TMP"
fi

# Position of each theme in the `/theme` picker, which applies a choice as
# soon as its digit is typed -- so a running session is "/theme<CR>" plus one
# key. Keep in sync with CLAUDE_THEME_KEY in gruvim/lua/config/theme.lua.
case "$CLAUDE_THEME" in
auto) CLAUDE_KEY=1 ;;
dark) CLAUDE_KEY=2 ;;
light) CLAUDE_KEY=3 ;;
dark-daltonized) CLAUDE_KEY=4 ;;
light-daltonized) CLAUDE_KEY=5 ;;
dark-ansi) CLAUDE_KEY=6 ;;
light-ansi) CLAUDE_KEY=7 ;;
*) CLAUDE_KEY="" ;;
esac

# claude is a child of the pane's shell, and the executable it runs is the
# version number (.../claude/versions/2.1.228), so neither the pane's pid nor
# `#{pane_current_command}` names it. Walk the pane's process tree instead.
pane_runs_claude() {
  ps -Ao pid=,ppid=,comm= | awk -v root="$1" '
    { ppid[$1] = $2; comm[$1] = $3 }
    END {
      for (pid in comm) {
        if (comm[pid] !~ /(^|\/)claude$/ && comm[pid] !~ /\/claude\/versions\//) continue
        cur = pid
        for (hop = 0; hop < 8 && cur != ""; hop++) {
          if (cur == root) { exit 0 }
          cur = ppid[cur]
        }
      }
      exit 1
    }'
}

CLAUDE_EDITOR_MODE=""
if [ -f "$CLAUDE_SETTINGS" ] && command -v jq >/dev/null 2>&1; then
  CLAUDE_EDITOR_MODE="$(jq -r '.editorMode // ""' "$CLAUDE_SETTINGS" 2>/dev/null)"
fi

# Whatever sits after the last prompt marker on screen. The marker is not
# anchored to the start of the line: depending on the version the input box
# draws a border or an indent in front of it.
prompt_text() {
  printf '%s\n' "$1" | grep '❯' | tail -1 | sed 's/.*❯[[:space:]]*//' | tr -d '[:space:]'
}

# Drives one pane's `/theme` picker, putting back whatever was in its prompt.
switch_pane_theme() {
  pane="$1"
  screen="$2"

  # Typing into a busy session or an open dialog is not just lost -- a digit
  # answers a permission prompt. Only type at an idle prompt.
  case "$screen" in
  *"esc to interrupt"* | *"to confirm"* | *"❯ 1."*) return ;;
  esac

  # A prompt sitting in vim normal mode reads "/theme" as normal-mode commands
  # instead of text, so the picker never opens. `A` returns to insert at the
  # end of the line; in insert mode it would type a literal A instead, hence
  # the check for the mode indicator.
  if [ "$CLAUDE_EDITOR_MODE" = "vim" ]; then
    case "$screen" in
    *"-- INSERT --"*) ;;
    *)
      tmux send-keys -t "$pane" "A"
      sleep 0.2
      ;;
    esac
  fi

  before="$(prompt_text "$screen")"

  # C-u kills back to the cursor and C-k forward from it, so the pair clears a
  # line wherever the cursor sits. One pair per line, overshooting is free, and
  # the kills accumulate into a single C-y.
  i=0
  while [ "$i" -lt 8 ]; do
    tmux send-keys -t "$pane" C-u
    tmux send-keys -t "$pane" C-k
    i=$((i + 1))
  done

  # Only restore when those kills actually took something. Asking the screen
  # rather than trusting the earlier read keeps this working whatever the input
  # box looks like: an empty prompt is unchanged by the kills, and C-y would
  # then paste back a draft killed by an earlier run.
  sleep 0.3
  after="$(prompt_text "$(tmux capture-pane -p -t "$pane" | tail -8)")"

  tmux send-keys -t "$pane" "/theme" Enter
  sleep 0.6
  tmux send-keys -t "$pane" "$CLAUDE_KEY"

  if [ "$before" != "$after" ]; then
    sleep 0.6
    tmux send-keys -t "$pane" C-y
  fi
}

if [ "${CLAUDE_LIVE_THEME:-0}" = "1" ] && [ -n "$CLAUDE_KEY" ] &&
  command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
  tmux list-panes -a -F '#{pane_id} #{pane_pid} #{pane_current_command}' |
    while read -r pane pane_pid pane_cmd; do
      # Panes running an editor host claude in a terminal buffer, where these
      # keys would land in the editor instead. Neovim switches those itself.
      case "$pane_cmd" in
      nvim | vim) continue ;;
      esac

      # The bottom of the screen: the prompt, its footer, and any open dialog.
      pane_screen="$(tmux capture-pane -p -t "$pane" | tail -8)"

      # A claude on the far end of an ssh session is not in this tree; run
      # toggle-theme on that machine instead.
      pane_runs_claude "$pane_pid" || continue

      switch_pane_theme "$pane" "$pane_screen"
    done
fi

# === Tmux ===
if command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
  tmux set-option -g status-fg "$TMUX_STATUS_FG"
  tmux set-option -g status-bg "$TMUX_STATUS_BG"

  tmux set-option -g message-style "bg=brightyellow,fg=black"
  tmux set-option -g message-command-style "bg=black,fg=brightyellow"

  tmux set-option -g pane-border-style "fg=$TMUX_PANE_BORDER_FG"
  tmux set-option -g pane-active-border-style "fg=$TMUX_PANE_ACTIVE_BORDER_FG"

  tmux display-message "Theme: $NEW_MODE"
else
  echo "Theme: $NEW_MODE"
fi
