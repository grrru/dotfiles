#!/bin/bash
#
# Switch light/dark mode across Ghostty, tmux, Neovim and Claude Code.
#
#   toggle-theme            flip the current mode
#   toggle-theme light      force light mode
#   toggle-theme dark       force dark mode
#   toggle-theme --apply    re-apply the current mode without flipping it
#
# Themes come from theme.defaults.conf in the dotfiles root, overridden by the
# git-ignored theme.conf next to it. Put only the keys that differ on this
# machine into theme.conf.

STATE_FILE="$HOME/.theme_mode"
# Resolve the dotfiles root from this script's location (scripts/ -> repo root),
# falling back to ~/dotfiles when invoked through a copied path.
DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)"
[ -d "$DOTFILES/ghostty" ] || DOTFILES="$HOME/dotfiles"

# This script is the only reader of the theme config: tracked defaults first,
# then the first existing machine-local override on top of them. Every tool
# gets a generated file from here instead.
if [ ! -f "$DOTFILES/theme.defaults.conf" ]; then
  echo "toggle-theme: $DOTFILES/theme.defaults.conf not found" >&2
  exit 1
fi
# shellcheck source=SCRIPTDIR/../theme.defaults.conf
. "$DOTFILES/theme.defaults.conf"

for THEME_CONF in \
  ${DOTFILES_THEME_CONF:+"$DOTFILES_THEME_CONF"} \
  "$DOTFILES/theme.conf" \
  "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/theme.conf"; do
  if [ -f "$THEME_CONF" ]; then
    # shellcheck source=/dev/null
    . "$THEME_CONF"
    break
  fi
done

# The mode applied last. Older versions wrote just the bare word.
read_mode() {
  case "$(sed -n 1p "$STATE_FILE" 2>/dev/null)" in
  'MODE="light"' | light) echo "light" ;;
  *) echo "dark" ;;
  esac
}

# === Determine the target mode ===
case "${1-}" in
"")
  if [ "$(read_mode)" = "dark" ]; then NEW_MODE="light"; else NEW_MODE="dark"; fi
  ;;
light | dark) NEW_MODE="$1" ;;
--apply) NEW_MODE="$(read_mode)" ;;
-h | --help)
  sed -n '3,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  exit 0
  ;;
*)
  echo "toggle-theme: unknown argument '$1' (expected light, dark, --apply)" >&2
  exit 1
  ;;
esac

if [ "$NEW_MODE" = "light" ]; then
  GHOSTTY_THEME="$GHOSTTY_LIGHT_THEME"
  FONT_THICKEN_STRENGTH="$LIGHT_FONT_THICKEN_STRENGTH"
  NVIM_COLORSCHEME="$NVIM_LIGHT_COLORSCHEME"
  TMUX_STATUS_FG="$TMUX_LIGHT_STATUS_FG"
  TMUX_STATUS_BG="$TMUX_LIGHT_STATUS_BG"
  TMUX_PANE_BORDER_FG="$TMUX_LIGHT_PANE_BORDER_FG"
  TMUX_PANE_ACTIVE_BORDER_FG="$TMUX_LIGHT_PANE_ACTIVE_BORDER_FG"
  CLAUDE_THEME="$CLAUDE_LIGHT_THEME"
else
  GHOSTTY_THEME="$GHOSTTY_DARK_THEME"
  FONT_THICKEN_STRENGTH="$DARK_FONT_THICKEN_STRENGTH"
  NVIM_COLORSCHEME="$NVIM_DARK_COLORSCHEME"
  TMUX_STATUS_FG="$TMUX_DARK_STATUS_FG"
  TMUX_STATUS_BG="$TMUX_DARK_STATUS_BG"
  TMUX_PANE_BORDER_FG="$TMUX_DARK_PANE_BORDER_FG"
  TMUX_PANE_ACTIVE_BORDER_FG="$TMUX_DARK_PANE_ACTIVE_BORDER_FG"
  CLAUDE_THEME="$CLAUDE_DARK_THEME"
fi

# === Neovim ===
# Neovim watches this file and applies what it names. MODE stays on the first
# line, where read_mode looks. A single write, so the watcher never fires on a
# half-written file.
printf 'MODE="%s"\nNVIM_COLORSCHEME="%s"\n' "$NEW_MODE" "$NVIM_COLORSCHEME" >"$STATE_FILE"

# === Ghostty ===
GHOSTTY_CONFIG="$DOTFILES/ghostty/config"
GHOSTTY_LOCAL_CONFIG="$DOTFILES/ghostty/theme.local"
if [ -d "$(dirname "$GHOSTTY_LOCAL_CONFIG")" ]; then
  {
    printf 'theme = %s\n' "$GHOSTTY_THEME"
    if [ "${FONT_THICKEN_STRENGTH:-0}" -gt 0 ] 2>/dev/null; then
      printf 'font-thicken = true\n'
      printf 'font-thicken-strength = %s\n' "$FONT_THICKEN_STRENGTH"
    else
      printf 'font-thicken = false\n'
    fi
  } >"$GHOSTTY_LOCAL_CONFIG"
  # Ghostty reloads when the main config file's mtime changes.
  touch "$GHOSTTY_CONFIG"
fi

# === Claude Code ===
# Claude Code reads its theme from settings.json at startup. With `auto` it then
# follows the terminal's background on its own (see the end of this script).
CLAUDE_SETTINGS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
if [ -n "$CLAUDE_THEME" ] && [ -f "$CLAUDE_SETTINGS" ] && command -v jq >/dev/null 2>&1; then
  CLAUDE_TMP="$(mktemp "${TMPDIR:-/tmp}/toggle-theme.XXXXXX")"
  if jq --arg theme "$CLAUDE_THEME" '.theme = $theme' "$CLAUDE_SETTINGS" >"$CLAUDE_TMP"; then
    # Write through the existing file rather than renaming over it: keeping the
    # inode keeps any watcher Claude Code has on the path attached.
    cat "$CLAUDE_TMP" >"$CLAUDE_SETTINGS"
  fi
  rm -f "$CLAUDE_TMP"
fi

# === Tmux ===
# tmux.conf sources theme.local, so a reload with `C-a r` and a fresh server
# both come up in the current mode.
TMUX_LOCAL_CONFIG="$DOTFILES/tmux/theme.local"
{
  printf '# Generated by scripts/toggle-theme (%s mode). Do not edit; change theme.conf instead.\n' "$NEW_MODE"
  printf 'set -g status-fg "%s"\n' "$TMUX_STATUS_FG"
  printf 'set -g status-bg "%s"\n' "$TMUX_STATUS_BG"
  printf 'set -g message-style "%s"\n' "$TMUX_MESSAGE_STYLE"
  printf 'set -g message-command-style "%s"\n' "$TMUX_MESSAGE_COMMAND_STYLE"
  printf 'set -g mode-style "%s"\n' "$TMUX_MODE_STYLE"
  printf 'set -g copy-mode-match-style "%s"\n' "$TMUX_COPY_MODE_MATCH_STYLE"
  printf 'set -g copy-mode-current-match-style "%s"\n' "$TMUX_COPY_MODE_CURRENT_MATCH_STYLE"
  printf 'set -g copy-mode-mark-style "%s"\n' "$TMUX_COPY_MODE_MARK_STYLE"
  printf 'set -g pane-border-style "fg=%s"\n' "$TMUX_PANE_BORDER_FG"
  printf 'set -g pane-active-border-style "fg=%s"\n' "$TMUX_PANE_ACTIVE_BORDER_FG"
} >"$TMUX_LOCAL_CONFIG"

if command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
  tmux source-file "$TMUX_LOCAL_CONFIG"
  tmux display-message "Theme: $NEW_MODE"

  # Claude Code's `auto` theme asks tmux for the background, and tmux 3.6+
  # answers with the attached terminal's and tells panes when it changes. tmux
  # only asks the terminal again when the terminal reports a theme change, so
  # ask on its behalf; the answer arrives as the terminal's input. The sleep
  # lets a terminal reloading its config on this toggle (Ghostty) finish first.
  sleep 0.3
  tmux list-clients -F '#{client_tty}' | while read -r client_tty; do
    # shellcheck disable=SC1003 # an ESC \ string terminator, not a quote escape
    printf '\033]11;?\033\\' >"$client_tty" 2>/dev/null
  done
else
  echo "Theme: $NEW_MODE"
fi
