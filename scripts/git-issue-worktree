#!/usr/bin/env bash
# git-issue-worktree.sh
# 여러 git 레포에 대해 issue 브랜치 + worktree를 한번에 셋업/정리
#
# 사용법:
#   git-issue-worktree.sh setup <issue> [--tag <tag>] [--repo <repo>]...
#   git-issue-worktree.sh clean <issue> [tag] [--yes] [--delete-remote | --keep-remote]
#   git-issue-worktree.sh list [issue]
#
# <issue>는 번호(42), '#42', 이슈/PR URL을 모두 받는다.
# stdin이 터미널이 아니면 프롬프트와 fzf 대신 옵션으로만 값을 받는다.
#
# 환경변수:
#   WORKTREE    worktree를 생성할 베이스 경로 (필수)
#   WORKSPACE   레포들이 모여있는 경로 (필수)

set -euo pipefail

# ── 실행 모드 ──────────────────────────────────────────────────────────────────
# 프롬프트(read)와 fzf는 stdin이 터미널일 때만 띄운다.
INTERACTIVE=false
if [[ -t 0 ]]; then INTERACTIVE=true; fi

# ── 색상 출력 ──────────────────────────────────────────────────────────────────
# 실제 ESC 바이트로 정의 (echo -e / printf '%s' 양쪽에서 안전하게 사용)
# stdout이 터미널이 아니거나 NO_COLOR가 있으면 색을 끈다.
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  RED=$'\033[0;31m'
  GREEN=$'\033[0;32m'
  YELLOW=$'\033[1;33m'
  CYAN=$'\033[0;36m'
  BOLD=$'\033[1m'
  DIM=$'\033[2m'
  RESET=$'\033[0m'
else
  RED="" GREEN="" YELLOW="" CYAN="" BOLD="" DIM="" RESET=""
fi

info() { echo -e "${CYAN}[INFO]${RESET}  $*"; }
success() { echo -e "${GREEN}[OK]${RESET}    $*"; }
warn() { echo -e "${YELLOW}[WARN]${RESET}  $*"; }
error() { echo -e "${RED}[ERROR]${RESET} $*" >&2; }

# ── 사용법 ─────────────────────────────────────────────────────────────────────
usage() {
  local code="${1:-1}"
  if ((code != 0)); then exec >&2; fi
  cat <<EOF
Usage: $(basename "$0") <command> <issue> [tag] [options]

Commands:
  setup <issue>         이슈 브랜치 + worktree 생성
  clean <issue> [tag]   이슈 브랜치 + worktree 정리
  list [issue]          만들어 둔 이슈 tree와 worktree 경로 출력

Arguments:
  issue       이슈 번호(42), 이슈/PR URL, 또는 '#42' (따옴표 필요)
              URL 예: https://github.com/acme/backend-api/issues/42
  tag         브랜치/worktree 이름에 붙일 태그 (clean 시 생략하면 자동 감지)

Options:
  -t, --tag <tag>     태그 지정. 태그 없이는 --tag ''
                      setup: 같은 태그의 tree가 있으면 그 tree에 레포를 추가
  -r, --repo <repo>   setup 대상 레포. 여러 개면 반복. 레포명 또는 WORKSPACE 기준 경로
  -y, --yes           clean 최종 확인을 건너뛴다
  --delete-remote     clean 시 원격 브랜치도 삭제
  --keep-remote       clean 시 원격 브랜치 유지 (터미널이 없을 때 기본값)
  -h, --help          도움말 출력

Environment:
  WORKTREE    worktree 베이스 경로 (필수)
  WORKSPACE   레포들이 모여있는 경로 (필수)
  NO_COLOR    값이 있으면 색 없이 출력 (stdout이 터미널이 아니어도 꺼짐)

터미널 없이 실행 (에이전트, 스크립트):
  stdin이 터미널이 아니면 프롬프트와 fzf를 띄우지 않는다.
  setup 은 --tag 와 --repo 가 필요하고, 빠지면 필요한 옵션과 후보를 출력하고 종료한다.
  clean 은 --yes 가 없으면 정리 대상만 출력하고 아무것도 지우지 않는다.

레포 선택 화면 (fzf, --repo 를 주지 않았을 때):
  레포명을 타이핑하면 fuzzy 검색으로 후보가 좁혀집니다 (예: bkapi → backend-api).
  ↑↓ 이동 · Tab 선택/해제 · Ctrl-A 전체 · Ctrl-D 전체 해제 · Enter 확정 · ESC 취소

Examples:
  export WORKTREE=~/worktrees
  export WORKSPACE=~/projects
  $(basename "$0") setup 42
  $(basename "$0") setup https://github.com/acme/backend-api/issues/42
  $(basename "$0") setup 42 --tag auth-refactor --repo backend-api --repo frontend
  $(basename "$0") list 42
  $(basename "$0") clean 42
  $(basename "$0") clean 42 error-code --yes --keep-remote
EOF
  exit "$code"
}

# ── 옵션 파싱 ──────────────────────────────────────────────────────────────────
OPT_TAG=""
OPT_TAG_SET=false # --tag '' (태그 없음)와 미지정을 구분한다
declare -a OPT_REPOS=()
OPT_YES=false
OPT_REMOTE="" # delete | keep | "" (미지정)
declare -a POSITIONAL=()

parse_args() {
  while (($# > 0)); do
    case "$1" in
    -t | --tag | -r | --repo)
      if (($# < 2)); then
        error "$1 에 값이 필요합니다."
        exit 1
      fi
      if [[ "$1" == -t || "$1" == --tag ]]; then
        OPT_TAG="$2"
        OPT_TAG_SET=true
      else
        OPT_REPOS+=("$2")
      fi
      shift 2
      ;;
    --tag=*)
      OPT_TAG="${1#--tag=}"
      OPT_TAG_SET=true
      shift
      ;;
    --repo=*)
      OPT_REPOS+=("${1#--repo=}")
      shift
      ;;
    -y | --yes)
      OPT_YES=true
      shift
      ;;
    --delete-remote)
      OPT_REMOTE=delete
      shift
      ;;
    --keep-remote)
      OPT_REMOTE=keep
      shift
      ;;
    -h | --help) usage 0 ;;
    --)
      shift
      POSITIONAL+=("$@")
      break
      ;;
    -?*)
      error "알 수 없는 옵션: '$1'"
      usage 1
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
    esac
  done
}

# ── 공통 환경변수 검증 ─────────────────────────────────────────────────────────
check_env() {
  if [[ -z "${WORKTREE:-}" ]]; then
    error "\$WORKTREE 환경변수가 설정되지 않았습니다. 예: export WORKTREE=\"\$HOME/worktrees\""
    exit 1
  fi
  if [[ -z "${WORKSPACE:-}" ]]; then
    error "\$WORKSPACE 환경변수가 설정되지 않았습니다. 예: export WORKSPACE=\"\$HOME/projects\""
    exit 1
  fi
  if [[ ! -d "$WORKSPACE" ]]; then
    error "WORKSPACE 경로가 존재하지 않습니다: $WORKSPACE"
    exit 1
  fi
}

# ── 이슈 참조 파싱 ─────────────────────────────────────────────────────────────
# 번호(42), 축약형('#42'), 이슈/PR URL을 받아 ISSUE_NUM_PARSED에 번호만 남긴다.
# URL은 브라우저에서 그대로 복사해오기 때문에 프래그먼트(#issuecomment-…), 쿼리스트링,
# 하위 경로(/files)가 붙어 있어도 번호를 집어낸다.
#
# 호스트는 일절 검사하지 않고 /issues/N, /pull/N 경로 모양만 본다. 그래서 github.com과
# 사내 GitHub Enterprise를 구분할 필요 없이 양쪽 주소가 그대로 통과한다.
ISSUE_NUM_PARSED=""
ISSUE_SOURCE="" # URL로 받았을 때의 "owner/repo" — 잘못 붙여넣었는지 확인용

parse_issue_ref() {
  local input="$1"
  local num=""

  ISSUE_NUM_PARSED=""
  ISSUE_SOURCE=""

  if [[ "$input" == */* ]]; then
    if [[ "$input" =~ /(issues|pull)/([0-9]+) ]]; then
      num="${BASH_REMATCH[2]}"
    fi
    if [[ "$input" =~ ([^/]+/[^/]+)/(issues|pull)/[0-9]+ ]]; then
      ISSUE_SOURCE="${BASH_REMATCH[1]}"
    fi
  else
    num="${input#\#}"
  fi

  # 번호는 브랜치명(issue/N)과 디렉토리명, tracker 검색 패턴에 그대로 들어가므로
  # 여기서 숫자임을 보장해야 한다.
  if [[ ! "$num" =~ ^[0-9]+$ ]]; then
    error "이슈 번호를 알아낼 수 없습니다: '${input}'"
    error "번호(42), '#42', 또는 이슈/PR URL을 넣어주세요."
    return 1
  fi

  ISSUE_NUM_PARSED="$num"
}

# ── 태그 → 디렉토리 이름 ───────────────────────────────────────────────────────
# 태그는 공백을 '-'로 바꾸고 영숫자, '-', '_'만 남긴다.
sanitize_tag() {
  local tag
  tag="$(printf '%s' "$1" | tr ' ' '-' | tr -cd '[:alnum:]-_')"
  if [[ -n "$1" && -z "$tag" ]]; then
    error "태그에 쓸 수 있는 글자가 없습니다: '$1' (영숫자, '-', '_')"
    return 1
  fi
  echo "$tag"
}

# issue_suffix <issue> <tag> → "42-tag" 또는 태그가 없으면 "42"
issue_suffix() {
  if [[ -n "$2" ]]; then
    echo "$1-$2"
  else
    echo "$1"
  fi
}

# dir_tag <issue_dir> <issue> → 디렉토리 이름에서 이슈 번호를 뗀 태그
dir_tag() {
  local base="${1##*/}"
  if [[ "$base" == "$2" ]]; then
    echo ""
  else
    echo "${base#"$2"-}"
  fi
}

# ── WORKSPACE 하위 레포 탐색 ───────────────────────────────────────────────────
find_repos() {
  declare -n _repos="$1"
  while IFS= read -r git_dir; do
    _repos+=("$(dirname "$git_dir")")
  done < <(find "$WORKSPACE" -maxdepth 2 -name ".git" -type d | sort)
}

repo_names() {
  declare -n _names_src="$1"
  local repo out=""
  for repo in "${_names_src[@]}"; do out+="${repo##*/} "; done
  echo "${out% }"
}

# ── WORKTREE 하위 이슈 디렉토리 탐색 ───────────────────────────────────────────
#   find_issue_dirs <결과_배열명> [issue]
# .issue-tracker가 있는 디렉토리를 모은다. issue를 주면 그 번호의 디렉토리만 남긴다.
find_issue_dirs() {
  declare -n _dirs="$1"
  local issue="${2:-}" tracker
  for tracker in "$WORKTREE"/*/.issue-tracker; do
    if [[ ! -f "$tracker" ]]; then continue; fi
    if [[ -n "$issue" ]] && ! grep -qx "ISSUE_NUM=${issue}" "$tracker"; then continue; fi
    _dirs+=("${tracker%/.issue-tracker}")
  done
}

# 이슈 디렉토리 하나를 태그, 브랜치, worktree 경로와 함께 출력한다.
print_issue_dir() {
  local dir="$1" issue="" branch="" line rp wp mark tag width=0 name
  declare -a names=() paths=()

  while IFS= read -r line; do
    case "$line" in
    ISSUE_NUM=*) issue="${line#ISSUE_NUM=}" ;;
    BRANCH=*) branch="${line#BRANCH=}" ;;
    REPO$'\t'*)
      IFS=$'\t' read -r _ rp wp <<<"$line"
      names+=("${rp##*/}")
      paths+=("$wp")
      if ((${#names[-1]} > width)); then width=${#names[-1]}; fi
      ;;
    esac
  done <"$dir/.issue-tracker"

  tag="$(dir_tag "$dir" "$issue")"
  echo -e "${BOLD}Issue #${issue}${RESET}  tag: ${tag:-(없음)}  branch: ${branch}"
  echo -e "  ${dir}"
  for i in "${!names[@]}"; do
    mark=""
    if [[ ! -d "${paths[$i]}" ]]; then mark="  ${YELLOW}(디렉토리 없음)${RESET}"; fi
    echo -e "    $(printf '%-*s' "$width" "${names[$i]}")  ${paths[$i]}${mark}"
  done
}

# ══════════════════════════════════════════════════════════════════════════════
# 레포 선택기 — 이름을 타이핑하면 fzf가 후보를 좁힌다
#
#   pick_repos <결과_배열명> <후보_배열명>
# ══════════════════════════════════════════════════════════════════════════════

pick_repos() {
  declare -n __out="$1"
  declare -n __src="$2"

  if ! command -v fzf &>/dev/null; then
    error "레포 선택에 fzf가 필요합니다. ./install.sh deps 로 설치하세요."
    exit 1
  fi

  local i name width=0
  for i in "${!__src[@]}"; do
    name="$(basename "${__src[$i]}")"
    if ((${#name} > width)); then width=${#name}; fi
  done

  local input=""
  for i in "${!__src[@]}"; do
    input+="$(printf '%d\t%-*s  %s' \
      "$i" "$width" "$(basename "${__src[$i]}")" "${__src[$i]/#$WORKSPACE\//}")"$'\n'
  done

  local picked="" rc=0
  # 선택 개수를 테두리 라벨에 표시한다 (fzf 0.58에는 multi 이벤트가 없어 선택 액션마다 붙인다)
  local count_label='transform-border-label(if [ "$FZF_SELECT_COUNT" -gt 0 ]; then echo " ✓ ${FZF_SELECT_COUNT}개 선택됨 "; else echo " 선택 없음 "; fi)'
  # --with-nth=2 로 인덱스 필드는 화면/검색 대상에서 제외된다
  # (--nth 를 함께 주면 변환된 라인에 delimiter가 없어 매치가 0이 되므로 쓰지 않는다)
  picked="$(printf '%s' "$input" | fzf \
    --multi --delimiter=$'\t' --with-nth=2 \
    --prompt='레포 검색> ' \
    --header='이름 입력=검색  Tab=선택/해제  ^A=전체선택  ^D=전체해제  Enter=확정  ESC=취소' \
    --header-first --reverse --height='~80%' --border=rounded --info=inline \
    --border-label=' 선택 없음 ' --border-label-pos=-3 \
    --pointer='❯' --marker='✓ ' --highlight-line \
    --color='marker:green:bold,selected-fg:green:bold,selected-bg:22,label:yellow:bold' \
    --bind="tab:toggle+${count_label},ctrl-a:select-all+${count_label},ctrl-d:deselect-all+${count_label}")" || rc=$?

  __out=()
  if [[ -z "$picked" ]]; then
    if ((rc != 0 && rc != 1 && rc != 130)); then
      error "fzf 실행 실패(exit ${rc})"
      exit 1
    fi
    return 0
  fi

  # fzf 출력 순서와 무관하게 원본 순서를 유지
  declare -A marked=()
  local idx
  while IFS=$'\t' read -r idx _; do
    if [[ "$idx" =~ ^[0-9]+$ ]]; then marked[$idx]=1; fi
  done <<<"$picked"

  for i in "${!__src[@]}"; do
    if [[ -n "${marked[$i]:-}" ]]; then __out+=("${__src[$i]}"); fi
  done
}

# ── --repo 이름 → 레포 경로 ────────────────────────────────────────────────────
#   resolve_repos <결과_배열명> <후보_배열명>
# OPT_REPOS의 각 이름을 레포명, WORKSPACE 기준 상대 경로, 절대 경로 순으로 정확히 맞춘다.
# 결과는 후보 순서를 따른다.
resolve_repos() {
  declare -n __resolved="$1"
  declare -n __cands="$2"
  declare -A wanted=()
  declare -a missing=()
  local name repo found

  for name in "${OPT_REPOS[@]}"; do
    name="${name%/}"
    found=""
    for repo in "${__cands[@]}"; do
      if [[ "$name" == "${repo##*/}" || "$name" == "${repo#"$WORKSPACE"/}" || "$name" == "$repo" ]]; then
        found="$repo"
        break
      fi
    done
    if [[ -n "$found" ]]; then
      wanted[$found]=1
    else
      missing+=("$name")
    fi
  done

  if [[ ${#missing[@]} -gt 0 ]]; then
    error "WORKSPACE에서 찾을 수 없는 레포: ${missing[*]}"
    error "후보: $(repo_names __cands)"
    exit 1
  fi

  __resolved=()
  for repo in "${__cands[@]}"; do
    if [[ -n "${wanted[$repo]:-}" ]]; then __resolved+=("$repo"); fi
  done
}

# ══════════════════════════════════════════════════════════════════════════════
# setup 커맨드
# ══════════════════════════════════════════════════════════════════════════════
cmd_setup() {
  local ISSUE_NUM="$1"

  declare -a ALL_REPOS=()
  find_repos ALL_REPOS

  if [[ ${#ALL_REPOS[@]} -eq 0 ]]; then
    error "$WORKSPACE 하위에서 git 레포를 찾을 수 없습니다."
    exit 1
  fi

  # ── 기존 이슈 디렉토리 탐색 ─────────────────────────────────────────────────
  declare -a EXISTING_DIRS=()
  find_issue_dirs EXISTING_DIRS "$ISSUE_NUM"

  # ── 터미널이 없으면 프롬프트 대신 옵션이 모두 있어야 한다 ───────────────────
  if ! $INTERACTIVE && { ! $OPT_TAG_SET || [[ ${#OPT_REPOS[@]} -eq 0 ]]; }; then
    {
      error "터미널이 없어 프롬프트를 띄울 수 없습니다. 아래 옵션을 넘겨주세요."
      if ! $OPT_TAG_SET; then echo "  --tag <tag>     태그 없이 만들려면 --tag ''"; fi
      if [[ ${#OPT_REPOS[@]} -eq 0 ]]; then echo "  --repo <repo>   여러 개면 반복"; fi
      if [[ ${#EXISTING_DIRS[@]} -gt 0 ]]; then
        echo ""
        echo "Issue #${ISSUE_NUM}의 기존 tree (같은 --tag 를 주면 그 tree에 레포를 추가):"
        for d in "${EXISTING_DIRS[@]}"; do print_issue_dir "$d"; done
      fi
      echo ""
      echo "레포 후보: $(repo_names ALL_REPOS)"
    } >&2
    exit 1
  fi

  declare -a REPOS=()
  if [[ ${#OPT_REPOS[@]} -gt 0 ]]; then
    resolve_repos REPOS ALL_REPOS
  fi

  local REUSE_BASE="" ISSUE_TAG="" SUFFIX="" BRANCH ISSUE_BASE

  if $OPT_TAG_SET; then
    # ── 태그가 가리키는 tree가 이미 있으면 거기에 추가 ──────────────────────────
    ISSUE_TAG="$(sanitize_tag "$OPT_TAG")"
    SUFFIX="$(issue_suffix "$ISSUE_NUM" "$ISSUE_TAG")"
    for d in "${EXISTING_DIRS[@]}"; do
      if [[ "$d" == "${WORKTREE}/${SUFFIX}" ]]; then REUSE_BASE="$d"; fi
    done
  elif [[ ${#EXISTING_DIRS[@]} -gt 0 ]]; then
    echo ""
    echo -e "${YELLOW}${BOLD}Issue #${ISSUE_NUM}의 기존 worktree 디렉토리를 찾았습니다:${RESET}"
    for i in "${!EXISTING_DIRS[@]}"; do
      echo -e "  $((i + 1)). ${EXISTING_DIRS[$i]}"
    done
    echo ""
    echo -e "${DIM}여기에 레포를 추가하거나, 다른 태그로 새 tree를 만들 수 있습니다.${RESET}"
    echo ""

    if [[ ${#EXISTING_DIRS[@]} -eq 1 ]]; then
      read -r -p "여기에 추가하시겠습니까? (n=다른 태그로 새 tree) [Y/n]: " ANS
      if [[ ! "$ANS" =~ ^[Nn]$ ]]; then
        REUSE_BASE="${EXISTING_DIRS[0]}"
      fi
    else
      read -r -p "재사용할 디렉토리 번호 (Enter=새 tree 생성): " SEL
      if [[ "$SEL" =~ ^[0-9]+$ ]]; then
        local IDX=$((SEL - 1))
        if [[ $IDX -ge 0 && $IDX -lt ${#EXISTING_DIRS[@]} ]]; then
          REUSE_BASE="${EXISTING_DIRS[$IDX]}"
        fi
      fi
    fi
  fi

  if [[ -n "$REUSE_BASE" ]]; then
    # ── 기존 디렉토리 재사용 ──────────────────────────────────────────────────
    ISSUE_BASE="$REUSE_BASE"
    SUFFIX="$(basename "$ISSUE_BASE")"
    BRANCH="$(grep '^BRANCH=' "$ISSUE_BASE/.issue-tracker" | head -1 | sed 's/^BRANCH=//')"
    if [[ -z "$BRANCH" ]]; then
      error "기존 tracker에서 BRANCH를 읽을 수 없습니다: $ISSUE_BASE/.issue-tracker"
      exit 1
    fi
    echo ""
    echo -e "${BOLD}Issue #${ISSUE_NUM} 기존 worktree에 레포 추가${RESET}"
    echo -e "${DIM}─────────────────────────────────────────${RESET}"
    info "재사용 경로:   ${ISSUE_BASE}"
    info "재사용 브랜치: ${BRANCH}"
    echo ""
  else
    # ── 새 tree 생성 (태그를 옵션으로 받지 않았으면 입력) ─────────────────────
    echo ""
    echo -e "${BOLD}Issue #${ISSUE_NUM} worktree 셋업${RESET}"
    echo -e "${DIM}─────────────────────────────────────────${RESET}"
    if ! $OPT_TAG_SET; then
      if [[ ${#EXISTING_DIRS[@]} -gt 0 ]]; then
        echo -e "${YELLOW}기존과 다른 태그를 입력해주세요.${RESET}"
      fi
      echo -e "브랜치/worktree 이름에 붙일 태그를 입력하세요."
      echo -e "${DIM}예: auth-refactor  →  issue/42-auth-refactor${RESET}"
      echo -e "${DIM}(생략하면 issue/42 형태로 생성)${RESET}"
      echo ""
      read -r -p "태그 (생략 가능): " ISSUE_TAG
      ISSUE_TAG="$(sanitize_tag "$ISSUE_TAG")"
      SUFFIX="$(issue_suffix "$ISSUE_NUM" "$ISSUE_TAG")"
    fi

    BRANCH="issue/${SUFFIX}"
    ISSUE_BASE="${WORKTREE}/${SUFFIX}"

    # 기존 디렉토리와 충돌 체크
    for d in "${EXISTING_DIRS[@]}"; do
      if [[ "$d" == "$ISSUE_BASE" ]]; then
        error "기존 디렉토리와 같은 경로입니다: ${ISSUE_BASE}"
        error "다른 태그를 사용하거나 재실행 후 재사용 옵션을 선택하세요."
        exit 1
      fi
    done

    echo ""
    echo -e "  브랜치명:  ${GREEN}${BRANCH}${RESET}"
    echo -e "  worktree:  ${GREEN}${ISSUE_BASE}/${RESET}{repo_name}${GREEN}_${SUFFIX}${RESET}"
    echo ""
  fi

  # ── 레포 선택 인터랙션 (--repo 를 받지 않았을 때) ─────────────────────────────
  if [[ ${#OPT_REPOS[@]} -eq 0 ]]; then
    echo -e "${BOLD}레포 선택${RESET}  ${DIM}(레포명을 입력하면 후보가 좁혀집니다)${RESET}"
    echo -e "${DIM}─────────────────────────────────────────${RESET}"
    pick_repos REPOS ALL_REPOS
  fi

  if [[ ${#REPOS[@]} -eq 0 ]]; then
    warn "선택된 레포가 없습니다. 종료합니다."
    exit 0
  fi

  # ── 셋업 실행 ─────────────────────────────────────────────────────────────────
  echo -e "${BOLD}── 셋업 시작 ──────────────────────────────────${RESET}"
  info "이슈 번호:  #${ISSUE_NUM}"
  if [[ -n "$ISSUE_SOURCE" ]]; then
    info "이슈 출처:  ${ISSUE_SOURCE}"
  fi
  info "브랜치:     ${BRANCH}"
  info "base 경로:  ${ISSUE_BASE}"
  info "대상 레포:  ${#REPOS[@]}개"
  for r in "${REPOS[@]}"; do echo -e "              ${DIM}$(basename "$r")${RESET}"; done
  echo ""

  mkdir -p "$ISSUE_BASE"
  declare -a FAILED=()
  declare -a TRACKER_ENTRIES=() # "REPO_PATH\tWORKTREE_PATH"

  # 기존 tracker entries 시드 (재사용 시 기존 레포 정보 유지)
  if [[ -n "$REUSE_BASE" && -f "$ISSUE_BASE/.issue-tracker" ]]; then
    while IFS= read -r line; do
      case "$line" in
      REPO$'\t'*) TRACKER_ENTRIES+=("${line#REPO$'\t'}") ;;
      esac
    done <"$ISSUE_BASE/.issue-tracker"
  fi

  # tracker entry 추가 (중복 제거)
  add_tracker_entry() {
    local new_entry="$1"
    local e
    for e in "${TRACKER_ENTRIES[@]}"; do
      [[ "$e" == "$new_entry" ]] && return
    done
    TRACKER_ENTRIES+=("$new_entry")
  }

  for REPO_PATH in "${REPOS[@]}"; do
    local REPO_NAME WORKTREE_PATH
    REPO_NAME="$(basename "$REPO_PATH")"
    WORKTREE_PATH="${ISSUE_BASE}/${REPO_NAME}_${SUFFIX}"

    echo -e "${CYAN}──────────────────────────────────────────${RESET}"
    info "레포: ${BOLD}${REPO_NAME}${RESET}  ${DIM}(${REPO_PATH})${RESET}"

    if [[ -d "$WORKTREE_PATH" ]]; then
      warn "이미 존재하는 worktree, 스킵: ${WORKTREE_PATH}"
      add_tracker_entry "${REPO_PATH}	${WORKTREE_PATH}"
      continue
    fi

    (
      cd "$REPO_PATH"
      info "  git fetch..."
      git fetch --quiet

      local DEFAULT_BRANCH
      DEFAULT_BRANCH=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null |
        sed 's|refs/remotes/origin/||' ||
        git branch -r | grep -E 'origin/(main|master)' | head -1 | sed 's|.*origin/||' | tr -d ' ')
      DEFAULT_BRANCH="${DEFAULT_BRANCH:-main}"

      if git show-ref --verify --quiet "refs/heads/${BRANCH}"; then
        info "  브랜치 이미 존재, 재사용: ${BRANCH}"
      else
        info "  브랜치 생성: ${BRANCH}  ${DIM}(from ${DEFAULT_BRANCH})${RESET}"
        if ! git branch "$BRANCH" "origin/${DEFAULT_BRANCH}" 2>/dev/null; then
          git branch "$BRANCH" "$DEFAULT_BRANCH"
        fi
      fi

      info "  worktree 추가: ${WORKTREE_PATH}"
      git worktree add "$WORKTREE_PATH" "$BRANCH" --quiet
      success "  완료: ${REPO_NAME} → ${WORKTREE_PATH}"
    ) || {
      error "처리 실패: ${REPO_NAME}"
      FAILED+=("$REPO_NAME")
      [[ -d "$WORKTREE_PATH" ]] && rmdir "$WORKTREE_PATH" 2>/dev/null || true
      continue
    }
    add_tracker_entry "${REPO_PATH}	${WORKTREE_PATH}"
  done

  # ── .issue-tracker 저장 ───────────────────────────────────────────────────────
  {
    echo "ISSUE_NUM=${ISSUE_NUM}"
    echo "BRANCH=${BRANCH}"
    for entry in "${TRACKER_ENTRIES[@]}"; do
      echo "REPO	${entry}"
    done
  } >"${ISSUE_BASE}/.issue-tracker"
  info "tracker 저장: ${ISSUE_BASE}/.issue-tracker"

  echo ""
  echo -e "${CYAN}══════════════════════════════════════════${RESET}"
  echo -e "${GREEN}${BOLD}Issue #${ISSUE_NUM} worktree 셋업 완료${RESET}"
  print_issue_dir "$ISSUE_BASE"

  if [[ ${#FAILED[@]} -gt 0 ]]; then
    echo ""
    warn "실패한 레포: ${FAILED[*]}"
    exit 1
  fi
}

# ══════════════════════════════════════════════════════════════════════════════
# clean 커맨드
# ══════════════════════════════════════════════════════════════════════════════
cmd_clean() {
  local ISSUE_NUM="$1"

  # ── 이슈 디렉토리 탐색 ───────────────────────────────────────────────────────
  declare -a ISSUE_DIRS=()
  find_issue_dirs ISSUE_DIRS "$ISSUE_NUM"

  if [[ ${#ISSUE_DIRS[@]} -eq 0 ]]; then
    error "ISSUE #${ISSUE_NUM}의 .issue-tracker 파일을 찾을 수 없습니다."
    error "setup 커맨드로 생성한 worktree가 아니거나 이미 정리됐을 수 있습니다."
    exit 1
  fi

  local ISSUE_BASE="" d
  if $OPT_TAG_SET; then
    local TARGET
    TARGET="${WORKTREE}/$(issue_suffix "$ISSUE_NUM" "$(sanitize_tag "$OPT_TAG")")"
    for d in "${ISSUE_DIRS[@]}"; do
      if [[ "$d" == "$TARGET" ]]; then ISSUE_BASE="$d"; fi
    done
    if [[ -z "$ISSUE_BASE" ]]; then
      error "Issue #${ISSUE_NUM}에 tag '${OPT_TAG}'인 tree가 없습니다. 있는 tree:"
      for d in "${ISSUE_DIRS[@]}"; do print_issue_dir "$d"; done >&2
      exit 1
    fi
  elif [[ ${#ISSUE_DIRS[@]} -eq 1 ]]; then
    ISSUE_BASE="${ISSUE_DIRS[0]}"
  elif $INTERACTIVE; then
    echo -e "${BOLD}여러 tree 감지 — 선택하세요:${RESET}"
    for i in "${!ISSUE_DIRS[@]}"; do
      echo -e "  $((i + 1)). ${ISSUE_DIRS[$i]}"
    done
    echo ""
    read -r -p "번호: " SEL
    if [[ ! "$SEL" =~ ^[0-9]+$ ]] || ((SEL < 1 || SEL > ${#ISSUE_DIRS[@]})); then
      error "잘못된 번호입니다: '${SEL}'"
      exit 1
    fi
    ISSUE_BASE="${ISSUE_DIRS[$((SEL - 1))]}"
  else
    error "Issue #${ISSUE_NUM}의 tree가 여러 개입니다. tag를 지정하세요 (clean ${ISSUE_NUM} <tag>):"
    for d in "${ISSUE_DIRS[@]}"; do print_issue_dir "$d"; done >&2
    exit 1
  fi

  local TRACKER_FILE="${ISSUE_BASE}/.issue-tracker"

  # ── tracker 파싱 ─────────────────────────────────────────────────────────────
  local BRANCH=""
  declare -a REPO_PATHS=()
  declare -a WORKTREE_PATHS=()

  while IFS= read -r line; do
    case "$line" in
    BRANCH=*) BRANCH="${line#BRANCH=}" ;;
    REPO$'\t'*)
      IFS=$'\t' read -r _ rp wp <<<"$line"
      REPO_PATHS+=("$rp")
      WORKTREE_PATHS+=("$wp")
      ;;
    esac
  done <"$TRACKER_FILE"

  if [[ -z "$BRANCH" || ${#REPO_PATHS[@]} -eq 0 ]]; then
    error "tracker 파일을 읽을 수 없습니다: $TRACKER_FILE"
    exit 1
  fi

  # ── 원격 브랜치 삭제 여부 (옵션 → 프롬프트 → 터미널이 없으면 유지) ──────────
  local DELETE_REMOTE=false ASK_REMOTE=false
  case "$OPT_REMOTE" in
  delete) DELETE_REMOTE=true ;;
  keep) ;;
  *) if $INTERACTIVE; then ASK_REMOTE=true; fi ;;
  esac

  # ── 정리 대상 출력 ────────────────────────────────────────────────────────────
  echo ""
  echo -e "${BOLD}Issue #${ISSUE_NUM} 정리${RESET}"
  echo -e "${DIM}─────────────────────────────────────────${RESET}"
  echo -e "  브랜치:    ${RED}${BRANCH}${RESET}"
  echo -e "  worktree:  ${RED}${ISSUE_BASE}${RESET}"
  if ! $ASK_REMOTE; then
    if $DELETE_REMOTE; then
      echo -e "  원격:      ${RED}origin/${BRANCH} 삭제${RESET}"
    else
      echo -e "  원격:      origin/${BRANCH} 유지"
    fi
  fi
  echo ""
  echo -e "${BOLD}정리 대상:${RESET}"
  for i in "${!REPO_PATHS[@]}"; do
    echo -e "  ${DIM}$(basename "${REPO_PATHS[$i]}")${RESET}  →  ${DIM}${WORKTREE_PATHS[$i]}${RESET}"
  done
  echo ""

  if $ASK_REMOTE; then
    read -r -p "원격 브랜치(origin/${BRANCH})도 삭제할까요? [y/N] " REMOTE_ANSWER
    [[ "$REMOTE_ANSWER" =~ ^[Yy]$ ]] && DELETE_REMOTE=true
  fi

  # ── 최종 확인 ────────────────────────────────────────────────────────────────
  if $OPT_YES; then
    :
  elif $INTERACTIVE; then
    echo ""
    read -r -p "$(echo -e "${RED}${BOLD}위 항목을 모두 삭제합니다. 계속할까요? [y/N]${RESET} ")" CONFIRM
    if ! [[ "$CONFIRM" =~ ^[Yy]$ ]]; then
      info "취소했습니다."
      exit 0
    fi
    echo ""
  else
    error "터미널이 없어 확인을 받을 수 없습니다. 아무것도 지우지 않았습니다."
    error "위 항목을 지우려면 --yes 를 붙여 다시 실행하세요."
    exit 1
  fi

  declare -a FAILED=()

  for i in "${!REPO_PATHS[@]}"; do
    local REPO_PATH="${REPO_PATHS[$i]}"
    local WORKTREE_PATH="${WORKTREE_PATHS[$i]}"
    local REPO_NAME
    REPO_NAME="$(basename "$REPO_PATH")"

    echo -e "${CYAN}──────────────────────────────────────────${RESET}"
    info "레포: ${BOLD}${REPO_NAME}${RESET}"

    (
      cd "$REPO_PATH"

      # worktree 제거
      if [[ -d "$WORKTREE_PATH" ]] || git worktree list --porcelain | grep -qF "$WORKTREE_PATH"; then
        info "  worktree 제거: ${WORKTREE_PATH}"
        git worktree remove --force "$WORKTREE_PATH" 2>/dev/null &&
          success "  worktree 제거 완료" ||
          warn "  worktree 제거 실패 (수동 확인 필요)"
      fi
      git worktree prune

      # 로컬 브랜치 삭제
      local CURRENT
      CURRENT=$(git branch --show-current 2>/dev/null || echo "")
      if [[ "$CURRENT" == "$BRANCH" ]]; then
        local DEFAULT_BRANCH
        DEFAULT_BRANCH=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null |
          sed 's|refs/remotes/origin/||' || echo "main")
        warn "  현재 브랜치가 ${BRANCH}입니다. ${DEFAULT_BRANCH}로 전환 후 삭제합니다."
        git checkout "$DEFAULT_BRANCH" --quiet
      fi

      if git show-ref --verify --quiet "refs/heads/${BRANCH}"; then
        git branch -D "$BRANCH"
        success "  로컬 브랜치 삭제: ${BRANCH}"
      else
        info "  로컬 브랜치 없음 (스킵)"
      fi

      # 원격 브랜치 삭제
      if [[ "$DELETE_REMOTE" == true ]]; then
        if git ls-remote --exit-code --heads origin "$BRANCH" &>/dev/null; then
          git push origin --delete "$BRANCH" --quiet
          success "  원격 브랜치 삭제: origin/${BRANCH}"
        else
          info "  원격 브랜치 없음 (스킵)"
        fi
      fi
    ) || {
      error "처리 실패: ${REPO_NAME}"
      FAILED+=("$REPO_NAME")
    }
  done

  # ── worktree 디렉토리 삭제 ───────────────────────────────────────────────────
  echo -e "${CYAN}──────────────────────────────────────────${RESET}"
  info "디렉토리 삭제: ${ISSUE_BASE}"
  rm -rf "$ISSUE_BASE"
  success "디렉토리 삭제 완료"

  echo ""
  echo -e "${CYAN}══════════════════════════════════════════${RESET}"
  if [[ ${#FAILED[@]} -gt 0 ]]; then
    warn "실패한 레포: ${FAILED[*]}"
    exit 1
  else
    echo -e "${GREEN}${BOLD}Issue #${ISSUE_NUM} 정리 완료${RESET}"
  fi
}

# ══════════════════════════════════════════════════════════════════════════════
# list 커맨드
# ══════════════════════════════════════════════════════════════════════════════
cmd_list() {
  local ISSUE_NUM="${1:-}"

  declare -a DIRS=()
  find_issue_dirs DIRS "$ISSUE_NUM"

  if [[ ${#DIRS[@]} -eq 0 ]]; then
    if [[ -n "$ISSUE_NUM" ]]; then
      error "Issue #${ISSUE_NUM}의 tree가 없습니다."
      exit 1
    fi
    info "만들어 둔 tree가 없습니다: ${WORKTREE}"
    return 0
  fi

  for i in "${!DIRS[@]}"; do
    if ((i > 0)); then echo ""; fi
    print_issue_dir "${DIRS[$i]}"
  done
}

# ══════════════════════════════════════════════════════════════════════════════
# 진입점
# ══════════════════════════════════════════════════════════════════════════════
[[ $# -lt 1 ]] && usage 1

COMMAND="$1"
shift

case "$COMMAND" in
-h | --help | help) usage 0 ;;
esac

parse_args "$@"
set -- "${POSITIONAL[@]}"

case "$COMMAND" in
setup)
  [[ $# -ne 1 ]] && usage 1
  if $OPT_YES || [[ -n "$OPT_REMOTE" ]]; then
    error "setup 은 --yes, --delete-remote, --keep-remote 를 받지 않습니다."
    exit 1
  fi
  check_env
  parse_issue_ref "$1" || exit 1
  cmd_setup "$ISSUE_NUM_PARSED"
  ;;
clean)
  [[ $# -lt 1 || $# -gt 2 ]] && usage 1
  if [[ ${#OPT_REPOS[@]} -gt 0 ]]; then
    error "clean 은 tree 단위로 정리하므로 --repo 를 받지 않습니다."
    exit 1
  fi
  if [[ $# -eq 2 ]]; then
    if $OPT_TAG_SET; then
      error "tag 를 위치 인자와 --tag 로 함께 줄 수 없습니다."
      exit 1
    fi
    OPT_TAG="$2"
    OPT_TAG_SET=true
  fi
  check_env
  parse_issue_ref "$1" || exit 1
  cmd_clean "$ISSUE_NUM_PARSED"
  ;;
list)
  [[ $# -gt 1 ]] && usage 1
  if $OPT_TAG_SET || $OPT_YES || [[ ${#OPT_REPOS[@]} -gt 0 || -n "$OPT_REMOTE" ]]; then
    error "list 는 옵션을 받지 않습니다."
    exit 1
  fi
  check_env
  if [[ $# -eq 1 ]]; then parse_issue_ref "$1" || exit 1; fi
  cmd_list "$ISSUE_NUM_PARSED"
  ;;
*)
  error "알 수 없는 커맨드: '$COMMAND'"
  usage 1
  ;;
esac
