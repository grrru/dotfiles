#!/usr/bin/env bash
# git-issue-worktree.sh
# 여러 git 레포에 대해 issue 브랜치 + worktree를 한번에 셋업/정리
#
# 사용법:
#   git-issue-worktree.sh setup <issue_num>
#   git-issue-worktree.sh clean <issue_num> [tag]
#
# 환경변수:
#   WORKTREE    worktree를 생성할 베이스 경로 (필수)
#   WORKSPACE   레포들이 모여있는 경로 (필수)

set -euo pipefail

# ── 색상 출력 ──────────────────────────────────────────────────────────────────
# 실제 ESC 바이트로 정의 (echo -e / printf '%s' 양쪽에서 안전하게 사용)
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
CYAN=$'\033[0;36m'
BOLD=$'\033[1m'
DIM=$'\033[2m'
RESET=$'\033[0m'

info() { echo -e "${CYAN}[INFO]${RESET}  $*"; }
success() { echo -e "${GREEN}[OK]${RESET}    $*"; }
warn() { echo -e "${YELLOW}[WARN]${RESET}  $*"; }
error() { echo -e "${RED}[ERROR]${RESET} $*" >&2; }

# ── 사용법 ─────────────────────────────────────────────────────────────────────
usage() {
  cat <<EOF
Usage: $(basename "$0") <command> <issue_num> [tag]

Commands:
  setup   이슈 브랜치 + worktree 생성
  clean   이슈 브랜치 + worktree 정리

Arguments:
  issue_num   이슈 번호 (숫자)
  tag         브랜치/worktree 이름에 붙일 태그 (clean 시 생략하면 자동 감지)

Environment:
  WORKTREE    worktree 베이스 경로 (필수)
  WORKSPACE   레포들이 모여있는 경로 (필수)
  GIW_PICKER  레포 선택 UI: auto(기본) | fzf | builtin

레포 선택 화면:
  레포명을 타이핑하면 fuzzy 검색으로 후보가 좁혀집니다 (예: bkapi → backend-api).
  ↑↓ 이동 · Space/Tab 선택/해제 · Ctrl-A 전체 · Enter 확정 · ESC 취소

Examples:
  export WORKTREE=~/worktrees
  export WORKSPACE=~/projects
  $(basename "$0") setup 42
  $(basename "$0") clean 42
  $(basename "$0") clean 42 error-code
EOF
  exit 1
}

# ── 공통 환경변수 검증 ─────────────────────────────────────────────────────────
check_env() {
  if [[ -z "${WORKTREE:-}" ]]; then
    error "\$WORKTREE 환경변수가 설정되지 않았습니다. 예: export WORKTREE=\"\$HOME/worktrees\""
    exit 1
  fi
  if [[ -z "${WORKSPACE:-}" ]]; then
    error "\$WORKSPACE 환경변수가 설정되지 않았습니다. 예: export WORKSPACE=\"\$HOME/projects\""
    exit 1
  fi
  if [[ ! -d "$WORKSPACE" ]]; then
    error "WORKSPACE 경로가 존재하지 않습니다: $WORKSPACE"
    exit 1
  fi
}

# ── WORKSPACE 하위 레포 탐색 ───────────────────────────────────────────────────
find_repos() {
  declare -n _repos="$1"
  while IFS= read -r git_dir; do
    _repos+=("$(dirname "$git_dir")")
  done < <(find "$WORKSPACE" -maxdepth 2 -name ".git" -type d | sort)
}

# ══════════════════════════════════════════════════════════════════════════════
# 레포 선택기 — 이름을 타이핑하면 자동으로 후보가 좁혀짐
#
#   pick_repos <결과_배열명> <후보_배열명>
#
#   GIW_PICKER=auto     fzf가 있으면 fzf, 없으면 내장 TUI (기본값)
#   GIW_PICKER=fzf      항상 fzf
#   GIW_PICKER=builtin  항상 내장 TUI (외부 의존 없음)
# ══════════════════════════════════════════════════════════════════════════════

# fuzzy 서브시퀀스 매칭: needle의 문자들이 haystack에 순서대로 나타나면 매치
#   예) "bkapi" → "backend-api",  "web" → "web-frontend"
_fuzzy_match() {
  local hay="${1,,}" needle="${2,,}" ch i
  for ((i = 0; i < ${#needle}; i++)); do
    ch="${needle:i:1}"
    if [[ "$ch" == " " ]]; then continue; fi
    case "$hay" in
    *"$ch"*) hay="${hay#*"$ch"}" ;;
    *) return 1 ;;
    esac
  done
  return 0
}

# ── fzf 기반 선택기 ───────────────────────────────────────────────────────────
_pick_repos_fzf() {
  declare -n __out="$1"
  declare -n __src="$2"

  local i name width=0
  for i in "${!__src[@]}"; do
    name="$(basename "${__src[$i]}")"
    if ((${#name} > width)); then width=${#name}; fi
  done

  local input=""
  for i in "${!__src[@]}"; do
    input+="$(printf '%d\t%-*s  %s' \
      "$i" "$width" "$(basename "${__src[$i]}")" "${__src[$i]/#$WORKSPACE\//}")"$'\n'
  done

  local picked="" rc=0
  # --with-nth=2 로 인덱스 필드는 화면/검색 대상에서 제외된다
  # (--nth 를 함께 주면 변환된 라인에 delimiter가 없어 매치가 0이 되므로 쓰지 않는다)
  picked="$(printf '%s' "$input" | fzf \
    --multi --delimiter=$'\t' --with-nth=2 \
    --prompt='레포 검색> ' \
    --header='이름 입력=검색  Tab=선택/해제  ^A=전체선택  ^D=전체해제  Enter=확정  ESC=취소' \
    --header-first --reverse --height='~80%' --border=rounded --info=inline \
    --pointer='❯' --marker='✓' \
    --bind='ctrl-a:select-all,ctrl-d:deselect-all')" || rc=$?

  __out=()
  if [[ -z "$picked" ]]; then
    if ((rc != 0 && rc != 1 && rc != 130)); then
      warn "fzf 실행 실패(exit ${rc}) — GIW_PICKER=builtin 으로 재시도해보세요."
    fi
    return 0
  fi

  # fzf 출력 순서와 무관하게 원본 순서를 유지
  declare -A marked=()
  local idx
  while IFS=$'\t' read -r idx _; do
    if [[ "$idx" =~ ^[0-9]+$ ]]; then marked[$idx]=1; fi
  done <<<"$picked"

  for i in "${!__src[@]}"; do
    if [[ -n "${marked[$i]:-}" ]]; then __out+=("${__src[$i]}"); fi
  done
}

# ── 내장 타입어헤드 TUI (외부 의존 없음) ──────────────────────────────────────
_P_STTY=""
_p_restore_tty() {
  printf '\033[?25h' # 커서 복구
  if [[ -n "$_P_STTY" ]]; then stty "$_P_STTY" </dev/tty 2>/dev/null || true; fi
}

# 표시 폭 계산 → _P_W (한글 등 non-ASCII는 2칸으로 근사).
# 줄이 터미널 폭을 넘겨 줄바꿈되면 프레임 지우기 줄 수 계산이 깨지므로 필요하다.
_P_W=0
_p_dwidth() {
  local s="$1" ascii="${1//[^ -~]/}"
  _P_W=$((${#s} * 2 - ${#ascii}))
}

_pick_repos_tui() {
  declare -n __out="$1"
  declare -n __src="$2"

  local n=${#__src[@]}
  declare -a P_NAME=() P_REL=() P_MARK=() P_FILT=()

  local i
  for ((i = 0; i < n; i++)); do
    P_NAME+=("$(basename "${__src[$i]}")")
    P_REL+=("${__src[$i]/#$WORKSPACE\//}")
    P_MARK+=("false")
  done

  local query="" cursor=0 win=0 frame=0 cancelled=false
  local rows max_rows
  rows="$(tput lines 2>/dev/null || echo 24)"
  max_rows=$((rows - 8))
  if ((max_rows > 12)); then max_rows=12; fi
  if ((max_rows < 3)); then max_rows=3; fi

  _p_refilter() {
    local j
    P_FILT=()
    for ((j = 0; j < n; j++)); do
      if _fuzzy_match "${P_NAME[$j]}" "$query" || _fuzzy_match "${P_REL[$j]}" "$query"; then
        P_FILT+=("$j")
      fi
    done
    if ((cursor >= ${#P_FILT[@]})); then cursor=$((${#P_FILT[@]} - 1)); fi
    if ((cursor < 0)); then cursor=0; fi
  }

  _p_move() {
    local total=${#P_FILT[@]}
    if ((total == 0)); then return 0; fi
    cursor=$((cursor + $1))
    if ((cursor < 0)); then cursor=0; fi
    if ((cursor > total - 1)); then cursor=$((total - 1)); fi
  }

  _p_toggle() {
    if ((${#P_FILT[@]} == 0)); then return 0; fi
    local idx="${P_FILT[$cursor]}"
    if [[ "${P_MARK[$idx]}" == "true" ]]; then P_MARK[$idx]="false"; else P_MARK[$idx]="true"; fi
    # 선택 후에는 검색어를 비워 다음 레포명을 바로 타이핑할 수 있게 한다
    if [[ -n "$query" ]]; then
      query=""
      _p_refilter
      cursor="$idx" # 쿼리가 비면 filtered == 전체이므로 인덱스가 곧 화면 위치
    fi
  }

  _p_toggle_all() {
    local j all_marked=true
    if ((${#P_FILT[@]} == 0)); then return 0; fi
    for j in "${P_FILT[@]}"; do
      if [[ "${P_MARK[$j]}" != "true" ]]; then
        all_marked=false
        break
      fi
    done
    for j in "${P_FILT[@]}"; do
      if [[ "$all_marked" == "true" ]]; then P_MARK[$j]="false"; else P_MARK[$j]="true"; fi
    done
  }

  _p_render() {
    # 직전 프레임 지우기
    if ((frame > 0)); then printf '\033[%dA\r\033[J' "$frame"; fi
    frame=0

    local cols total=${#P_FILT[@]} sel=0 buf="" j idx
    cols="$(tput cols 2>/dev/null || echo 80)"
    for j in "${P_MARK[@]}"; do
      if [[ "$j" == "true" ]]; then sel=$((sel + 1)); fi
    done

    _p_line() {
      buf+="$1"$'\n'
      frame=$((frame + 1))
    }

    # 터미널 폭에 맞는 가장 자세한 도움말을 고른다 (줄바꿈 방지)
    local help
    for help in \
      "이름 입력=검색  ↑↓=이동  Space/Tab=선택  ^A=전체  Enter=확정  ESC=취소" \
      "↑↓ 이동 · Space 선택 · ^A 전체 · Enter 확정 · ESC 취소" \
      "Space=선택 Enter=확정 ESC=취소" \
      "Space/Enter/ESC"; do
      _p_dwidth "$help"
      if ((_P_W <= cols)); then break; fi
    done
    _p_line "${DIM}${help}${RESET}"
    # 검색어가 길어도 한 줄을 넘기지 않도록 뒤쪽만 보여준다
    local q_disp="$query" off
    if ((${#q_disp} > cols - 8)); then
      off=$((${#q_disp} - (cols - 9)))
      q_disp="…${q_disp:off}"
    fi
    _p_line "  ${CYAN}❯${RESET} ${BOLD}${q_disp}${RESET}${DIM}█${RESET}"
    _p_line "${DIM}  ${total}/${n} 매치 · ${sel}개 선택${RESET}"

    local start=$win end=$((win + max_rows))
    if ((end > total)); then end=$total; fi

    if ((total == 0)); then
      if ((cols >= 52)); then
        _p_line "  ${YELLOW}매치되는 레포가 없습니다 (Ctrl-U로 검색어 초기화)${RESET}"
      else
        _p_line "  ${YELLOW}매치 없음 (^U 초기화)${RESET}"
      fi
    fi

    local mark name rel budget
    for ((j = start; j < end; j++)); do
      idx="${P_FILT[$j]}"
      if [[ "${P_MARK[$idx]}" == "true" ]]; then mark="${GREEN}✓${RESET}"; else mark=" "; fi
      name="${P_NAME[$idx]}"
      rel="${P_REL[$idx]}"
      # 한 줄을 넘기지 않도록 경로를 잘라낸다 (줄바꿈되면 프레임 지우기가 깨짐)
      budget=$((cols - 10 - ${#name}))
      if ((${#rel} > budget)); then
        if ((budget > 3)); then rel="${rel:0:budget-1}…"; else rel=""; fi
      fi
      if ((j == cursor)); then
        _p_line " ${CYAN}❯${RESET} [${mark}] ${BOLD}${name}${RESET}  ${DIM}${rel}${RESET}"
      else
        _p_line "   [${mark}] ${name}  ${DIM}${rel}${RESET}"
      fi
    done

    if ((total > end)); then _p_line "${DIM}   … $((total - end))개 더${RESET}"; fi

    printf '%s' "$buf"
  }

  # ── raw 모드 진입 ───────────────────────────────────────────────────────────
  # 복구용 termios는 트랩(서브셸/EXIT 시점)에서도 보이도록 전역에 보관
  _P_STTY="$(stty -g </dev/tty)"
  trap '_p_restore_tty' EXIT
  trap '_p_restore_tty; exit 130' INT TERM
  stty -echo -icanon min 1 time 0 </dev/tty
  printf '\033[?25l' # 커서 숨김

  _p_refilter

  local key rest
  while true; do
    # 커서를 항상 화면 안에 유지
    if ((cursor < win)); then win=$cursor; fi
    if ((cursor >= win + max_rows)); then win=$((cursor - max_rows + 1)); fi
    if ((win > ${#P_FILT[@]} - max_rows)); then win=$((${#P_FILT[@]} - max_rows)); fi
    if ((win < 0)); then win=0; fi

    _p_render

    key=""
    IFS= read -rsn1 key </dev/tty || key=""

    case "$key" in
    "" | $'\r') break ;; # Enter
    $'\x7f' | $'\b')     # Backspace
      query="${query%?}"
      cursor=0
      _p_refilter
      ;;
    $'\t' | " ") _p_toggle ;; # Tab / Space
    $'\x01') _p_toggle_all ;; # Ctrl-A
    $'\x15')                  # Ctrl-U
      query=""
      cursor=0
      _p_refilter
      ;;
    $'\x0e') _p_move 1 ;;  # Ctrl-N
    $'\x10') _p_move -1 ;; # Ctrl-P
    $'\x1b')               # ESC / 방향키
      rest=""
      IFS= read -rsn2 -t 0.05 rest </dev/tty || true
      case "$rest" in
      "[A") _p_move -1 ;;
      "[B") _p_move 1 ;;
      "[5" | "[6")
        IFS= read -rsn1 -t 0.05 _ </dev/tty || true
        if [[ "$rest" == "[5" ]]; then _p_move "-${max_rows}"; else _p_move "$max_rows"; fi
        ;;
      "")
        cancelled=true
        break
        ;;
      esac
      ;;
    *)
      if [[ "$key" == [[:print:]] ]]; then
        query+="$key"
        cursor=0
        _p_refilter
      fi
      ;;
    esac
  done

  # ── 정리: 프레임 지우고 raw 모드 복구 ───────────────────────────────────────
  if ((frame > 0)); then printf '\033[%dA\r\033[J' "$frame"; fi
  _p_restore_tty
  _P_STTY=""
  trap - EXIT INT TERM

  __out=()
  if [[ "$cancelled" == "true" ]]; then
    info "선택을 취소했습니다."
    return 0
  fi

  # 아무것도 토글하지 않고 Enter를 눌렀다면 커서 위 항목을 선택으로 간주
  local any=false j
  for j in "${P_MARK[@]}"; do
    if [[ "$j" == "true" ]]; then
      any=true
      break
    fi
  done
  if [[ "$any" == "false" && ${#P_FILT[@]} -gt 0 ]]; then
    P_MARK[${P_FILT[$cursor]}]="true"
  fi

  for ((j = 0; j < n; j++)); do
    if [[ "${P_MARK[$j]}" == "true" ]]; then __out+=("${__src[$j]}"); fi
  done
}

# ── 비대화형(TTY 없음) 폴백: 이름/번호 한 줄 입력 ─────────────────────────────
_pick_repos_plain() {
  declare -n __out="$1"
  declare -n __src="$2"

  local i
  for i in "${!__src[@]}"; do
    echo -e "  $((i + 1)). $(basename "${__src[$i]}")  ${DIM}${__src[$i]/#$WORKSPACE\//}${RESET}"
  done
  echo ""

  local input=""
  read -r -p "레포명 또는 번호 (쉼표/공백 구분, a=전체): " input || true

  declare -a picked=()
  for i in "${!__src[@]}"; do picked+=("false"); done

  if [[ "$input" == "a" || "$input" == "A" ]]; then
    for i in "${!picked[@]}"; do picked[$i]="true"; done
  else
    declare -a tokens=()
    IFS=', ' read -r -a tokens <<<"$input"
    local tok idx
    for tok in "${tokens[@]}"; do
      if [[ "$tok" =~ ^[0-9]+$ ]]; then
        idx=$((tok - 1))
        if ((idx >= 0 && idx < ${#__src[@]})); then
          picked[$idx]="true"
        else
          warn "범위를 벗어난 번호: $tok (1~${#__src[@]})"
        fi
        continue
      fi
      declare -a hits=()
      for i in "${!__src[@]}"; do
        if _fuzzy_match "$(basename "${__src[$i]}")" "$tok"; then hits+=("$i"); fi
      done
      case ${#hits[@]} in
      0) warn "매치되는 레포 없음: '$tok'" ;;
      1) picked[${hits[0]}]="true" ;;
      *)
        # 완전일치가 있으면 그것을 우선
        local exact=""
        for i in "${hits[@]}"; do
          if [[ "$(basename "${__src[$i]}")" == "$tok" ]]; then exact="$i"; fi
        done
        if [[ -n "$exact" ]]; then
          picked[$exact]="true"
        else
          warn "모호한 입력 '$tok' — 후보: $(for i in "${hits[@]}"; do printf '%s ' "$(basename "${__src[$i]}")"; done)"
        fi
        ;;
      esac
    done
  fi

  __out=()
  for i in "${!__src[@]}"; do
    if [[ "${picked[$i]}" == "true" ]]; then __out+=("${__src[$i]}"); fi
  done
}

# ── 디스패처 ──────────────────────────────────────────────────────────────────
pick_repos() {
  local out_name="$1" src_name="$2"
  local picker="${GIW_PICKER:-auto}"

  if [[ ! -r /dev/tty || ! -t 1 ]]; then
    _pick_repos_plain "$out_name" "$src_name"
    return
  fi

  case "$picker" in
  fzf) _pick_repos_fzf "$out_name" "$src_name" ;;
  builtin | tui) _pick_repos_tui "$out_name" "$src_name" ;;
  auto)
    if command -v fzf &>/dev/null; then
      _pick_repos_fzf "$out_name" "$src_name"
    else
      _pick_repos_tui "$out_name" "$src_name"
    fi
    ;;
  *)
    warn "알 수 없는 GIW_PICKER='${picker}' (auto|fzf|builtin) — 내장 선택기로 진행합니다."
    _pick_repos_tui "$out_name" "$src_name"
    ;;
  esac
}

# ══════════════════════════════════════════════════════════════════════════════
# setup 커맨드
# ══════════════════════════════════════════════════════════════════════════════
cmd_setup() {
  local ISSUE_NUM="$1"

  declare -a ALL_REPOS=()
  find_repos ALL_REPOS

  if [[ ${#ALL_REPOS[@]} -eq 0 ]]; then
    error "$WORKSPACE 하위에서 git 레포를 찾을 수 없습니다."
    exit 1
  fi

  # ── 기존 이슈 디렉토리 탐색 ─────────────────────────────────────────────────
  declare -a EXISTING_DIRS=()
  while IFS= read -r d; do
    [[ -z "$d" ]] && continue
    if [[ -f "$d/.issue-tracker" ]] && grep -q "^ISSUE_NUM=${ISSUE_NUM}$" "$d/.issue-tracker" 2>/dev/null; then
      EXISTING_DIRS+=("$d")
    fi
  done < <(find "$WORKTREE" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | sort)

  local REUSE_BASE=""
  if [[ ${#EXISTING_DIRS[@]} -gt 0 ]]; then
    echo ""
    echo -e "${YELLOW}${BOLD}Issue #${ISSUE_NUM}의 기존 worktree 디렉토리를 찾았습니다:${RESET}"
    for i in "${!EXISTING_DIRS[@]}"; do
      echo -e "  $((i + 1)). ${EXISTING_DIRS[$i]}"
    done
    echo ""
    echo -e "${DIM}여기에 레포를 추가하거나, 다른 태그로 새 tree를 만들 수 있습니다.${RESET}"
    echo ""

    if [[ ${#EXISTING_DIRS[@]} -eq 1 ]]; then
      read -r -p "여기에 추가하시겠습니까? (n=다른 태그로 새 tree) [Y/n]: " ANS
      if [[ ! "$ANS" =~ ^[Nn]$ ]]; then
        REUSE_BASE="${EXISTING_DIRS[0]}"
      fi
    else
      read -r -p "재사용할 디렉토리 번호 (Enter=새 tree 생성): " SEL
      if [[ "$SEL" =~ ^[0-9]+$ ]]; then
        local IDX=$((SEL - 1))
        if [[ $IDX -ge 0 && $IDX -lt ${#EXISTING_DIRS[@]} ]]; then
          REUSE_BASE="${EXISTING_DIRS[$IDX]}"
        fi
      fi
    fi
  fi

  local ISSUE_TAG SUFFIX BRANCH ISSUE_BASE

  if [[ -n "$REUSE_BASE" ]]; then
    # ── 기존 디렉토리 재사용 ──────────────────────────────────────────────────
    ISSUE_BASE="$REUSE_BASE"
    SUFFIX="$(basename "$ISSUE_BASE")"
    BRANCH="$(grep '^BRANCH=' "$ISSUE_BASE/.issue-tracker" | head -1 | sed 's/^BRANCH=//')"
    if [[ -z "$BRANCH" ]]; then
      error "기존 tracker에서 BRANCH를 읽을 수 없습니다: $ISSUE_BASE/.issue-tracker"
      exit 1
    fi
    echo ""
    echo -e "${BOLD}Issue #${ISSUE_NUM} 기존 worktree에 레포 추가${RESET}"
    echo -e "${DIM}─────────────────────────────────────────${RESET}"
    info "재사용 경로:   ${ISSUE_BASE}"
    info "재사용 브랜치: ${BRANCH}"
    echo ""
  else
    # ── 이슈 태그 입력 (새 tree 생성) ────────────────────────────────────────
    echo ""
    echo -e "${BOLD}Issue #${ISSUE_NUM} worktree 셋업${RESET}"
    echo -e "${DIM}─────────────────────────────────────────${RESET}"
    if [[ ${#EXISTING_DIRS[@]} -gt 0 ]]; then
      echo -e "${YELLOW}기존과 다른 태그를 입력해주세요.${RESET}"
    fi
    echo -e "브랜치/worktree 이름에 붙일 태그를 입력하세요."
    echo -e "${DIM}예: auth-refactor  →  issue/42-auth-refactor${RESET}"
    echo -e "${DIM}(생략하면 issue/42 형태로 생성)${RESET}"
    echo ""
    read -r -p "태그 (생략 가능): " ISSUE_TAG

    if [[ -n "$ISSUE_TAG" ]]; then
      ISSUE_TAG="$(echo "$ISSUE_TAG" | tr ' ' '-' | tr -cd '[:alnum:]-_')"
      SUFFIX="${ISSUE_NUM}-${ISSUE_TAG}"
    else
      SUFFIX="${ISSUE_NUM}"
    fi

    BRANCH="issue/${SUFFIX}"
    ISSUE_BASE="${WORKTREE}/${SUFFIX}"

    # 기존 디렉토리와 충돌 체크
    for d in "${EXISTING_DIRS[@]}"; do
      if [[ "$d" == "$ISSUE_BASE" ]]; then
        error "기존 디렉토리와 같은 경로입니다: ${ISSUE_BASE}"
        error "다른 태그를 사용하거나 재실행 후 재사용 옵션을 선택하세요."
        exit 1
      fi
    done

    echo ""
    echo -e "  브랜치명:  ${GREEN}${BRANCH}${RESET}"
    echo -e "  worktree:  ${GREEN}${ISSUE_BASE}/${RESET}{repo_name}${GREEN}_${SUFFIX}${RESET}"
    echo ""
  fi

  # ── 레포 선택 인터랙션 ────────────────────────────────────────────────────────
  echo -e "${BOLD}레포 선택${RESET}  ${DIM}(레포명을 입력하면 후보가 좁혀집니다)${RESET}"
  echo -e "${DIM}─────────────────────────────────────────${RESET}"

  declare -a REPOS=()
  pick_repos REPOS ALL_REPOS

  if [[ ${#REPOS[@]} -eq 0 ]]; then
    warn "선택된 레포가 없습니다. 종료합니다."
    exit 0
  fi

  # ── 셋업 실행 ─────────────────────────────────────────────────────────────────
  echo -e "${BOLD}── 셋업 시작 ──────────────────────────────────${RESET}"
  info "이슈 번호:  #${ISSUE_NUM}"
  info "브랜치:     ${BRANCH}"
  info "base 경로:  ${ISSUE_BASE}"
  info "대상 레포:  ${#REPOS[@]}개"
  for r in "${REPOS[@]}"; do echo -e "              ${DIM}$(basename "$r")${RESET}"; done
  echo ""

  mkdir -p "$ISSUE_BASE"
  declare -a FAILED=()
  declare -a TRACKER_ENTRIES=() # "REPO_PATH\tWORKTREE_PATH"

  # 기존 tracker entries 시드 (재사용 시 기존 레포 정보 유지)
  if [[ -n "$REUSE_BASE" && -f "$ISSUE_BASE/.issue-tracker" ]]; then
    while IFS= read -r line; do
      case "$line" in
      REPO$'\t'*) TRACKER_ENTRIES+=("${line#REPO$'\t'}") ;;
      esac
    done <"$ISSUE_BASE/.issue-tracker"
  fi

  # tracker entry 추가 (중복 제거)
  add_tracker_entry() {
    local new_entry="$1"
    local e
    for e in "${TRACKER_ENTRIES[@]}"; do
      [[ "$e" == "$new_entry" ]] && return
    done
    TRACKER_ENTRIES+=("$new_entry")
  }

  for REPO_PATH in "${REPOS[@]}"; do
    local REPO_NAME WORKTREE_PATH
    REPO_NAME="$(basename "$REPO_PATH")"
    WORKTREE_PATH="${ISSUE_BASE}/${REPO_NAME}_${SUFFIX}"

    echo -e "${CYAN}──────────────────────────────────────────${RESET}"
    info "레포: ${BOLD}${REPO_NAME}${RESET}  ${DIM}(${REPO_PATH})${RESET}"

    if [[ -d "$WORKTREE_PATH" ]]; then
      warn "이미 존재하는 worktree, 스킵: ${WORKTREE_PATH}"
      add_tracker_entry "${REPO_PATH}	${WORKTREE_PATH}"
      continue
    fi

    (
      cd "$REPO_PATH"
      info "  git fetch..."
      git fetch --quiet

      local DEFAULT_BRANCH
      DEFAULT_BRANCH=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null |
        sed 's|refs/remotes/origin/||' ||
        git branch -r | grep -E 'origin/(main|master)' | head -1 | sed 's|.*origin/||' | tr -d ' ')
      DEFAULT_BRANCH="${DEFAULT_BRANCH:-main}"

      if git show-ref --verify --quiet "refs/heads/${BRANCH}"; then
        info "  브랜치 이미 존재, 재사용: ${BRANCH}"
      else
        info "  브랜치 생성: ${BRANCH}  ${DIM}(from ${DEFAULT_BRANCH})${RESET}"
        if ! git branch "$BRANCH" "origin/${DEFAULT_BRANCH}" 2>/dev/null; then
          git branch "$BRANCH" "$DEFAULT_BRANCH"
        fi
      fi

      info "  worktree 추가: ${WORKTREE_PATH}"
      git worktree add "$WORKTREE_PATH" "$BRANCH" --quiet
      success "  완료: ${REPO_NAME} → ${WORKTREE_PATH}"
    ) || {
      error "처리 실패: ${REPO_NAME}"
      FAILED+=("$REPO_NAME")
      [[ -d "$WORKTREE_PATH" ]] && rmdir "$WORKTREE_PATH" 2>/dev/null || true
      continue
    }
    add_tracker_entry "${REPO_PATH}	${WORKTREE_PATH}"
  done

  # ── .issue-tracker 저장 ───────────────────────────────────────────────────────
  {
    echo "ISSUE_NUM=${ISSUE_NUM}"
    echo "BRANCH=${BRANCH}"
    for entry in "${TRACKER_ENTRIES[@]}"; do
      echo "REPO	${entry}"
    done
  } >"${ISSUE_BASE}/.issue-tracker"
  info "tracker 저장: ${ISSUE_BASE}/.issue-tracker"

  echo ""
  echo -e "${CYAN}══════════════════════════════════════════${RESET}"
  echo -e "${GREEN}${BOLD}Issue #${ISSUE_NUM} worktree 셋업 완료${RESET}"
  echo -e "경로: ${ISSUE_BASE}"

  if [[ ${#FAILED[@]} -gt 0 ]]; then
    echo ""
    warn "실패한 레포: ${FAILED[*]}"
    exit 1
  fi
}

# ══════════════════════════════════════════════════════════════════════════════
# clean 커맨드
# ══════════════════════════════════════════════════════════════════════════════
cmd_clean() {
  local ISSUE_NUM="$1"

  # ── tracker 파일 탐색 ─────────────────────────────────────────────────────────
  declare -a TRACKER_FILES=()
  while IFS= read -r f; do
    TRACKER_FILES+=("$f")
  done < <(find "$WORKTREE" -maxdepth 2 -name ".issue-tracker" 2>/dev/null |
    xargs grep -l "^ISSUE_NUM=${ISSUE_NUM}$" 2>/dev/null | sort)

  local TRACKER_FILE
  if [[ ${#TRACKER_FILES[@]} -eq 0 ]]; then
    error "ISSUE #${ISSUE_NUM}의 .issue-tracker 파일을 찾을 수 없습니다."
    error "setup 커맨드로 생성한 worktree가 아니거나 이미 정리됐을 수 있습니다."
    exit 1
  elif [[ ${#TRACKER_FILES[@]} -eq 1 ]]; then
    TRACKER_FILE="${TRACKER_FILES[0]}"
  else
    echo -e "${BOLD}여러 tracker 파일 감지 — 선택하세요:${RESET}"
    for i in "${!TRACKER_FILES[@]}"; do
      echo -e "  $((i + 1)). ${TRACKER_FILES[$i]}"
    done
    echo ""
    read -r -p "번호: " SEL
    TRACKER_FILE="${TRACKER_FILES[$((SEL - 1))]}"
  fi

  local ISSUE_BASE
  ISSUE_BASE="$(dirname "$TRACKER_FILE")"

  # ── tracker 파싱 ─────────────────────────────────────────────────────────────
  local BRANCH=""
  declare -a REPO_PATHS=()
  declare -a WORKTREE_PATHS=()

  while IFS= read -r line; do
    case "$line" in
    BRANCH=*) BRANCH="${line#BRANCH=}" ;;
    REPO$'\t'*)
      IFS=$'\t' read -r _ rp wp <<<"$line"
      REPO_PATHS+=("$rp")
      WORKTREE_PATHS+=("$wp")
      ;;
    esac
  done <"$TRACKER_FILE"

  if [[ -z "$BRANCH" || ${#REPO_PATHS[@]} -eq 0 ]]; then
    error "tracker 파일을 읽을 수 없습니다: $TRACKER_FILE"
    exit 1
  fi

  # ── 정리 대상 출력 ────────────────────────────────────────────────────────────
  echo ""
  echo -e "${BOLD}Issue #${ISSUE_NUM} 정리${RESET}"
  echo -e "${DIM}─────────────────────────────────────────${RESET}"
  echo -e "  브랜치:    ${RED}${BRANCH}${RESET}"
  echo -e "  worktree:  ${RED}${ISSUE_BASE}${RESET}"
  echo ""
  echo -e "${BOLD}정리 대상:${RESET}"
  for i in "${!REPO_PATHS[@]}"; do
    echo -e "  ${DIM}$(basename "${REPO_PATHS[$i]}")${RESET}  →  ${DIM}${WORKTREE_PATHS[$i]}${RESET}"
  done
  echo ""

  # ── 원격 브랜치 삭제 여부 ────────────────────────────────────────────────────
  local DELETE_REMOTE=false
  read -r -p "원격 브랜치(origin/${BRANCH})도 삭제할까요? [y/N] " REMOTE_ANSWER
  [[ "$REMOTE_ANSWER" =~ ^[Yy]$ ]] && DELETE_REMOTE=true

  # ── 최종 확인 ────────────────────────────────────────────────────────────────
  echo ""
  read -r -p "$(echo -e "${RED}${BOLD}위 항목을 모두 삭제합니다. 계속할까요? [y/N]${RESET} ")" CONFIRM
  if ! [[ "$CONFIRM" =~ ^[Yy]$ ]]; then
    info "취소했습니다."
    exit 0
  fi
  echo ""

  declare -a FAILED=()

  for i in "${!REPO_PATHS[@]}"; do
    local REPO_PATH="${REPO_PATHS[$i]}"
    local WORKTREE_PATH="${WORKTREE_PATHS[$i]}"
    local REPO_NAME
    REPO_NAME="$(basename "$REPO_PATH")"

    echo -e "${CYAN}──────────────────────────────────────────${RESET}"
    info "레포: ${BOLD}${REPO_NAME}${RESET}"

    (
      cd "$REPO_PATH"

      # worktree 제거
      if [[ -d "$WORKTREE_PATH" ]] || git worktree list --porcelain | grep -qF "$WORKTREE_PATH"; then
        info "  worktree 제거: ${WORKTREE_PATH}"
        git worktree remove --force "$WORKTREE_PATH" 2>/dev/null &&
          success "  worktree 제거 완료" ||
          warn "  worktree 제거 실패 (수동 확인 필요)"
      fi
      git worktree prune --quiet

      # 로컬 브랜치 삭제
      local CURRENT
      CURRENT=$(git branch --show-current 2>/dev/null || echo "")
      if [[ "$CURRENT" == "$BRANCH" ]]; then
        local DEFAULT_BRANCH
        DEFAULT_BRANCH=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null |
          sed 's|refs/remotes/origin/||' || echo "main")
        warn "  현재 브랜치가 ${BRANCH}입니다. ${DEFAULT_BRANCH}로 전환 후 삭제합니다."
        git checkout "$DEFAULT_BRANCH" --quiet
      fi

      if git show-ref --verify --quiet "refs/heads/${BRANCH}"; then
        git branch -D "$BRANCH"
        success "  로컬 브랜치 삭제: ${BRANCH}"
      else
        info "  로컬 브랜치 없음 (스킵)"
      fi

      # 원격 브랜치 삭제
      if [[ "$DELETE_REMOTE" == true ]]; then
        if git ls-remote --exit-code --heads origin "$BRANCH" &>/dev/null; then
          git push origin --delete "$BRANCH" --quiet
          success "  원격 브랜치 삭제: origin/${BRANCH}"
        else
          info "  원격 브랜치 없음 (스킵)"
        fi
      fi
    ) || {
      error "처리 실패: ${REPO_NAME}"
      FAILED+=("$REPO_NAME")
    }
  done

  # ── worktree 디렉토리 삭제 ───────────────────────────────────────────────────
  echo -e "${CYAN}──────────────────────────────────────────${RESET}"
  info "디렉토리 삭제: ${ISSUE_BASE}"
  rm -rf "$ISSUE_BASE"
  success "디렉토리 삭제 완료"

  echo ""
  echo -e "${CYAN}══════════════════════════════════════════${RESET}"
  if [[ ${#FAILED[@]} -gt 0 ]]; then
    warn "실패한 레포: ${FAILED[*]}"
    exit 1
  else
    echo -e "${GREEN}${BOLD}Issue #${ISSUE_NUM} 정리 완료${RESET}"
  fi
}

# ══════════════════════════════════════════════════════════════════════════════
# 진입점
# ══════════════════════════════════════════════════════════════════════════════
[[ $# -lt 1 ]] && usage

COMMAND="$1"
shift

case "$COMMAND" in
setup)
  [[ $# -lt 1 ]] && usage
  check_env
  cmd_setup "$1"
  ;;
clean)
  [[ $# -lt 1 ]] && usage
  check_env
  cmd_clean "$1" "${2:-}"
  ;;
*)
  error "알 수 없는 커맨드: '$COMMAND'"
  usage
  ;;
esac
